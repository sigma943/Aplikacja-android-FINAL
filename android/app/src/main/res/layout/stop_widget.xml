<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToOutline="true" android:background="@drawable/widget_glass_dark">
 <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no"/>
 <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
  <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="6dp">
   <ImageView android:id="@+id/widget_bus_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no"/>
   <ImageView android:id="@+id/widget_bus" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="6dp" android:src="@drawable/widget_bus" android:contentDescription="Autobus"/>
  </FrameLayout>
  <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:includeFontPadding="false" android:textStyle="bold" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
  <FrameLayout android:layout_width="32dp" android:layout_height="32dp">
  <ImageView android:id="@+id/widget_refresh_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no"/>
  <ImageView android:id="@+id/widget_refresh" android:layout_width="32dp" android:layout_height="32dp" android:padding="8dp" android:src="@drawable/widget_refresh" android:background="@drawable/widget_refresh_touch" android:clickable="true" android:focusable="true" android:contentDescription="Odśwież odjazdy"/>
  <FrameLayout android:id="@+id/widget_refresh_progress" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:contentDescription="Odświeżanie odjazdów"/>
  </FrameLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
 <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="12dp" android:maxLines="1" android:ellipsize="end" android:textSize="9sp" android:includeFontPadding="false"/>
</LinearLayout>
</FrameLayout>
