<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
 <TextView android:id="@+id/widget_line" android:layout_width="38dp" android:layout_height="22dp" android:gravity="center" android:background="@drawable/widget_badge" android:textStyle="bold" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="1"/>
 <TextView android:id="@+id/widget_direction" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="12sp"/>
 <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textStyle="bold" android:textSize="14sp" android:includeFontPadding="false" android:maxLines="1"/>
</LinearLayout>
